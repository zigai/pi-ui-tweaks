{
    "name": "@zigai/pi-tree",
    "version": "0.5.3",
    "description": "Pi package that improves /tree with timestamps and preview behavior.",
    "keywords": [
        "pi",
        "pi-coding-agent",
        "pi-extension",
        "pi-package",
        "pi-tweaks",
        "timestamps",
        "tree"
    ],
    "homepage": "https://github.com/zigai/pi-tweaks/tree/main/packages/pi-tree#readme",
    "bugs": {
        "url": "https://github.com/zigai/pi-tweaks/issues"
    },
    "license": "MIT",
    "author": "zigai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zigai/pi-tweaks.git",
        "directory": "packages/pi-tree"
    },
    "files": [
        "src",
        "assets",
        "README.md",
        "*.json"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@zigai/pi-extension-settings": "0.5.2"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "image": "https://raw.githubusercontent.com/zigai/pi-tweaks/master/packages/pi-tree/assets/tree-preview-demo.png",
        "extensions": [
            "./src/index.ts"
        ]
    },
    "piExtensionSettings": {
        "definition": "./src/settings-input.ts",
        "schema": "./config.schema.json",
        "readme": "./README.md",
        "prevalidation": "./src/settings.prevalidated.ts"
    }
}
