{
  "name": "pi-tweaks-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for personal Pi tweaks.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-tweaks"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run config:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "test": "vitest run --maxWorkers=8",
    "test:package": "node scripts/package-check.mjs",
    "typecheck": "tsc --noEmit",
    "release": "release --root .",
    "release:dry-run": "release --dry --root .",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.5.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-rules": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./packages/pi-model-filter/src/index.ts",
      "./packages/pi-ui-tweaks/src/index.ts",
      "./packages/pi-model-alias/src/index.ts",
      "./packages/pi-tree/src/index.ts",
      "./packages/pi-footer/src/index.ts",
      "./packages/pi-response-renderer/src/index.ts",
      "./packages/pi-plain-user-messages/src/index.ts",
      "./packages/pi-message-highlights/src/index.ts",
      "./packages/pi-status-bar/src/index.ts",
      "./packages/pi-keymap-tweaks/src/index.ts",
      "./packages/pi-model-modes/src/index.ts",
      "./packages/pi-prompt-history/src/index.ts",
      "./packages/pi-mention-skill/src/index.ts",
      "./packages/pi-mention-project/src/index.ts",
      "./packages/pi-trust-all-folders/src/index.ts"
    ]
  }
}
